{
  "document": {
    "Statement": [
      {
        "Action": [
          "ec2:DescribeAvailabilityZones",
          "ec2:DescribeImages",
          "ec2:DescribeInstances",
          "ec2:DescribeInternetGateways",
          "ec2:DescribeNetworkInterfaces",
          "ec2:DescribeRegions",
          "ec2:DescribeRouteTables",
          "ec2:DescribeSecurityGroupRules",
          "ec2:DescribeSecurityGroups",
          "ec2:DescribeSubnets",
          "ec2:DescribeVpcs",
          "ec2:GetConsoleOutput",
          "servicequotas:GetServiceQuota"
        ],
        "Effect": "Allow",
        "Resource": [
          "*"
        ],
        "Sid": "Read"
      },
      {
        "Action": [
          "ec2:CreateVpc"
        ],
        "Condition": {
          "StringEquals": {
            "aws:RequestTag/multicloud:managed": "true"
          }
        },
        "Effect": "Allow",
        "Resource": [
          "arn:aws:ec2:*:*:vpc/*"
        ],
        "Sid": "CreateTaggedVpc"
      },
      {
        "Action": [
          "ec2:CreateSubnet"
        ],
        "Condition": {
          "StringEquals": {
            "aws:RequestTag/multicloud:managed": "true"
          }
        },
        "Effect": "Allow",
        "Resource": [
          "arn:aws:ec2:*:*:subnet/*"
        ],
        "Sid": "CreateTaggedSubnet"
      },
      {
        "Action": [
          "ec2:CreateRouteTable"
        ],
        "Condition": {
          "StringEquals": {
            "aws:RequestTag/multicloud:managed": "true"
          }
        },
        "Effect": "Allow",
        "Resource": [
          "arn:aws:ec2:*:*:route-table/*"
        ],
        "Sid": "CreateTaggedRouteTable"
      },
      {
        "Action": [
          "ec2:CreateInternetGateway"
        ],
        "Condition": {
          "StringEquals": {
            "aws:RequestTag/multicloud:managed": "true"
          }
        },
        "Effect": "Allow",
        "Resource": [
          "arn:aws:ec2:*:*:internet-gateway/*"
        ],
        "Sid": "CreateTaggedInternetGateway"
      },
      {
        "Action": [
          "ec2:CreateSecurityGroup"
        ],
        "Condition": {
          "StringEquals": {
            "aws:RequestTag/multicloud:managed": "true"
          }
        },
        "Effect": "Allow",
        "Resource": [
          "arn:aws:ec2:*:*:security-group/*"
        ],
        "Sid": "CreateTaggedSecurityGroup"
      },
      {
        "Action": [
          "ec2:RunInstances"
        ],
        "Condition": {
          "StringEquals": {
            "aws:RequestTag/multicloud:managed": "true"
          }
        },
        "Effect": "Allow",
        "Resource": [
          "arn:aws:ec2:*:*:instance/*",
          "arn:aws:ec2:*:*:volume/*",
          "arn:aws:ec2:*:*:network-interface/*",
          "arn:aws:ec2:*:*:spot-instances-request/*"
        ],
        "Sid": "CreateTaggedInstances"
      },
      {
        "Action": [
          "ec2:CreateLaunchTemplate"
        ],
        "Condition": {
          "StringEquals": {
            "aws:RequestTag/multicloud:managed": "true"
          }
        },
        "Effect": "Allow",
        "Resource": [
          "arn:aws:ec2:*:*:launch-template/*"
        ],
        "Sid": "CreateTaggedLaunchTemplate"
      },
      {
        "Action": [
          "ec2:CreateFleet"
        ],
        "Condition": {
          "StringEquals": {
            "aws:RequestTag/multicloud:managed": "true"
          }
        },
        "Effect": "Allow",
        "Resource": [
          "arn:aws:ec2:*:*:fleet/*",
          "arn:aws:ec2:*:*:instance/*",
          "arn:aws:ec2:*:*:volume/*",
          "arn:aws:ec2:*:*:network-interface/*"
        ],
        "Sid": "CreateTaggedFleet"
      },
      {
        "Action": [
          "ec2:CreateSubnet",
          "ec2:CreateRouteTable",
          "ec2:CreateSecurityGroup",
          "ec2:RunInstances",
          "ec2:CreateFleet"
        ],
        "Condition": {
          "StringEquals": {
            "aws:ResourceTag/multicloud:managed": "true"
          }
        },
        "Effect": "Allow",
        "Resource": [
          "arn:aws:ec2:*:*:vpc/*",
          "arn:aws:ec2:*:*:subnet/*",
          "arn:aws:ec2:*:*:security-group/*",
          "arn:aws:ec2:*:*:launch-template/*"
        ],
        "Sid": "CreateInManagedParent"
      },
      {
        "Action": [
          "ec2:RunInstances",
          "ec2:CreateFleet"
        ],
        "Condition": {
          "StringEquals": {
            "ec2:Owner": [
              "099720109477",
              "amazon"
            ]
          }
        },
        "Effect": "Allow",
        "Resource": [
          "arn:aws:ec2:*::image/*"
        ],
        "Sid": "RunFromAnyImage"
      },
      {
        "Action": [
          "ec2:CreateTags"
        ],
        "Condition": {
          "StringEquals": {
            "ec2:CreateAction": [
              "CreateVpc",
              "CreateSubnet",
              "CreateRouteTable",
              "CreateInternetGateway",
              "CreateSecurityGroup",
              "RunInstances",
              "CreateLaunchTemplate",
              "CreateFleet"
            ]
          }
        },
        "Effect": "Allow",
        "Resource": [
          "*"
        ],
        "Sid": "TagOnCreate"
      },
      {
        "Action": [
          "ec2:AssociateRouteTable",
          "ec2:AttachInternetGateway",
          "ec2:AuthorizeSecurityGroupIngress",
          "ec2:CreateLaunchTemplateVersion",
          "ec2:CreateRoute",
          "ec2:CreateTags",
          "ec2:DeleteInternetGateway",
          "ec2:DeleteLaunchTemplate",
          "ec2:DeleteRouteTable",
          "ec2:DeleteSecurityGroup",
          "ec2:DeleteSubnet",
          "ec2:DeleteVpc",
          "ec2:DetachInternetGateway",
          "ec2:ModifySecurityGroupRules",
          "ec2:ModifySubnetAttribute",
          "ec2:ModifyVpcAttribute",
          "ec2:ReplaceRoute",
          "ec2:RevokeSecurityGroupEgress",
          "ec2:RevokeSecurityGroupIngress",
          "ec2:TerminateInstances"
        ],
        "Condition": {
          "StringEquals": {
            "aws:ResourceTag/multicloud:managed": "true"
          }
        },
        "Effect": "Allow",
        "Resource": [
          "*"
        ],
        "Sid": "MutateManaged"
      },
      {
        "Action": [
          "ec2:AuthorizeSecurityGroupIngress",
          "ec2:ModifySecurityGroupRules",
          "ec2:RevokeSecurityGroupEgress",
          "ec2:RevokeSecurityGroupIngress"
        ],
        "Effect": "Allow",
        "Resource": [
          "arn:aws:ec2:*:*:security-group-rule/*"
        ],
        "Sid": "SecurityGroupRules"
      },
      {
        "Action": [
          "servicequotas:RequestServiceQuotaIncrease",
          "servicequotas:ListRequestedServiceQuotaChangeHistory"
        ],
        "Condition": {
          "StringEquals": {
            "servicequotas:service": "ec2"
          }
        },
        "Effect": "Allow",
        "Resource": [
          "*"
        ],
        "Sid": "Quota"
      }
    ],
    "Version": "2012-10-17"
  },
  "policy_version": 2
}
