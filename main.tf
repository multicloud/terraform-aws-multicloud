# The role that Multicloud assumes in your account. It holds no access key and no secret:
# only the Multicloud broker roles named in var.broker_role_arns can assume it, and only
# with var.external_id.

locals {
  module_version = "1.2.0"

  # The source identity each Multicloud caller sets on its session (CloudTrail sourceIdentity).
  source_identities = var.source_identities

  # Generated by deploy/customer-terraform/policy/render.py. Do not edit by hand.
  bundle = jsondecode(file("${path.module}/policy.customer.json"))

  # With regions set, every action outside those regions is denied. ec2:DescribeRegions is
  # exempt: the connection check and the scheduler call it from a home region. The account:
  # region calls are exempt too: the Account Management API answers only in us-east-1. The
  # second Deny limits account:EnableRegion to the regions in the list (account:TargetRegion).
  region_statements = length(var.regions) == 0 ? [] : [
    {
      Sid       = "DenyOutsideAllowedRegions"
      Effect    = "Deny"
      NotAction = ["ec2:DescribeRegions", "account:ListRegions", "account:GetRegionOptStatus", "account:EnableRegion"]
      Resource  = "*"
      Condition = { StringNotEquals = { "aws:RequestedRegion" = var.regions } }
    },
  ]
  # A separate list: one tuple of two object shapes does not match the empty tuple.
  enable_region_statements = length(var.regions) == 0 ? [] : [
    {
      Sid       = "DenyEnableOutsideAllowedRegions"
      Effect    = "Deny"
      Action    = ["account:EnableRegion"]
      Resource  = "*"
      Condition = { StringNotEquals = { "account:TargetRegion" = var.regions } }
    },
  ]

  policy_document = {
    Version = local.bundle.document.Version
    Statement = concat(
      local.bundle.document.Statement,
      local.region_statements,
      local.enable_region_statements,
      local.ebs_kms_statements,
    )
  }
}

resource "random_id" "suffix" {
  byte_length = 4
}

resource "aws_iam_role" "provisioner" {
  name                 = "MulticloudProvisioner-${random_id.suffix.hex}"
  description          = "Assumed by Multicloud to manage tagged compute resources in this account."
  max_session_duration = 3600

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid       = "AssumeWithExternalId"
        Effect    = "Allow"
        Principal = { AWS = var.broker_role_arns }
        Action    = "sts:AssumeRole"
        Condition = { StringEquals = { "sts:ExternalId" = var.external_id } }
      },
      # AWS checks SetSourceIdentity and TagSession without the external ID in the request, so
      # they cannot share the statement above (live: implicit deny). Neither grants access alone:
      # both apply only to an AssumeRole call, which still needs the external ID.
      {
        Sid       = "SessionIdentity"
        Effect    = "Allow"
        Principal = { AWS = var.broker_role_arns }
        Action    = ["sts:SetSourceIdentity", "sts:TagSession"]
        Condition = { StringEquals = { "sts:SourceIdentity" = local.source_identities } }
      },
    ]
  })

  tags = {
    "multicloud:managed" = "true"
    "multicloud:org"     = var.org_slug
  }
}

resource "aws_iam_role_policy" "provisioner" {
  name   = "MulticloudProvisioner"
  role   = aws_iam_role.provisioner.id
  policy = jsonencode(local.policy_document)
}
